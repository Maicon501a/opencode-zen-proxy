# OpenCode Zen Proxy — configuration
# Copy to .env and adjust as needed.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# Maximum JSON request size. Base64 images are larger than their source files.
MAX_REQUEST_SIZE=50mb

# --- OpenCode Zen gateway ---
ZEN_API_BASE_URL=https://opencode.ai/zen/v1

# Bearer token sent to Zen. "public" (the default) unlocks the free-tier
# models without any login or local binary. Set a real Zen API key here to
# also access paid models.
ZEN_API_KEY=public

# --- Free-tier gate (leave these alone unless the official client changes) ---
# Since 2026-09-23 the Zen edge only answers free-model traffic that presents
# itself as the official OpenCode 2 CLI, streams the request body and advertises
# the `shell`/`read` function tools. These knobs exist so the disguise can be
# refreshed without touching code.
# ZEN_CLIENT_UA=opencode/latest/2.0.16/cli
# ZEN_CLIENT_SURFACE=cli
# ZEN_PROJECT_HEADER=5b259a0dee5146efb4be735cf465ba92bf944710

# --- Optional: gate client access to the proxy ---
# If set, clients must send this key in their Authorization header.
# When unset (default), the proxy is open for local use.
# CLIENT_API_KEY=

# --- Reasoning effort ---
# The upstream default is used when this is empty (the proxy never invents an
# effort; Zen free chat models default to "high"). Set it only to force an
# effort on every request. Clients can always override per request via
# "reasoning_effort", or per model with the "-low"/"-high"/"-max" alias suffix
# (e.g. "opencode/space-bunny-free-max").
# Accepted vocabulary: low | high | max on chat models,
#                       none | minimal | low | medium | high | xhigh on Muse.
DEFAULT_REASONING_EFFORT=

# --- Upstream timeouts ---
# Whole-request budget for a generation (long reasoning turns are slow).
UPSTREAM_TIMEOUT_MS=600000
# Budget for the live /v1/models catalog fetch before falling back to the
# built-in free list.
UPSTREAM_HEADERS_TIMEOUT_MS=120000

# --- WARP IP failover (egress escape hatch) ---
# Zen rate-limits by egress IP. When the upstream answers 429/502/503/504, a 500
# carrying the gateway's internal-error envelope, or a network failure, the
# proxy retries the same request once through Cloudflare WARP's SOCKS5 listener
# so it exits from a different IP. ONLY these requests go through WARP — your
# machine's normal connection is untouched.
WARP_AUTO_FAILOVER=true
WARP_SOCKS_HOST=127.0.0.1
WARP_SOCKS_PORT=40000
# How long to wait before trying to activate WARP again after a failed attempt.
WARP_COOLDOWN_MS=60000
# Path to the warp-cli binary (defaults to "warp-cli" on PATH).
# WARP_BIN_PATH=C:\Program Files\Cloudflare\Cloudflare WARP\warp-cli.exe

# Log level: debug, info, warn, error
LOG_LEVEL=info
