# OpenCode Zen Proxy (keyless, direct-to-Zen mode)

PORT=3000
HOST=0.0.0.0

# Zen API base URL.
ZEN_API_BASE_URL=https://opencode.ai/zen/v1

# Bearer token sent to Zen. "public" (the default) unlocks the free-tier
# models without any login or local binary. Set a real Zen API key here to
# also access paid models.
ZEN_API_KEY=public

# --- Optional: gate client access to the proxy ---
# If set, clients must send this key in their Authorization header.
# When unset (default), the proxy is open for local use.
# CLIENT_API_KEY=

# Default reasoning effort for reasoning-capable models (deepseek-v4-flash-free, ...).
# Accepted values: low | medium | high | max | xhigh
# "xhigh" maximizes chain-of-thought length. Clients can override per-request
# via the "reasoning_effort" field.
DEFAULT_REASONING_EFFORT=xhigh
# Keep HTTP requests transparent by default; set true only to force the value above.
INJECT_DEFAULT_REASONING_EFFORT=false

# Inject a system message with the current date/year into every request so the
# model knows the present instead of assuming its training cutoff (2023-2024).
# Set to false to disable.
INJECT_TEMPORAL_CONTEXT=true

# When true, requests carrying images/audio that target a known text-only model
# are automatically routed to the multimodal free model (mimo-v2.5-free) instead
# of being rejected with 400. When false, a clear error is returned instead.
AUTO_ROUTE_MULTIMODAL=true

# --- WARP SOCKS failover ---
# On a failover-eligible failure (network, 429/502/503/504, gateway 500) the
# proxy ACTIVATES WARP on demand via warp-cli (proxy port -> mode proxy ->
# connect -> verify Connected) and retries once through the local SOCKS5
# endpoint. The Docker image bundles the Cloudflare WARP client and starts the
# daemon automatically. The container runs with --network host, NET_ADMIN and
# /dev/net/tun (see docker-compose.yml).
WARP_AUTO_FAILOVER=true
WARP_SOCKS_HOST=127.0.0.1
WARP_SOCKS_PORT=40000
# Path to warp-cli (empty = resolve from PATH). On Windows auto-detected from
# Program Files.
# WARP_BIN_PATH=
# warp-cli command timeout (ms), wait after connect (ms), activation cooldown (ms)
# WARP_COMMAND_TIMEOUT=30000
# WARP_STARTUP_WAIT=1500
# WARP_COOLDOWN=60000
# The global --accept-tos flag is sent on every warp-cli command (required in
# headless/container environments). Set WARP_ACCEPT_TOS=false to disable.
# WARP_ACCEPT_TOS=true

# Log level: debug, info, warn, error
LOG_LEVEL=info
